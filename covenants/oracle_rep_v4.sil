pragma silverscript ^0.1.0;
// OracleRep v4 - DETACHED VERDICT model (checkSigFromStack).
//
// An oracle signs a VERDICT (delta + nonce + covenant_id), not the spending tx.
// Anyone can carry the signed verdict on-chain. Authority lives in the verdict,
// not in who submits. This is the "Everyone is an Oracle" primitive.
//
// State layout: repState(8B) + nonceState(8B) = 16 bytes.
// Verdict format: delta(8B LE) || nonce(8B LE) || covenant_id(32B) = 48 bytes.
// msg_hash = blake2b(verdict_bytes), signed with BIP340 schnorr.

contract OracleRep(byte[8] init_rep, byte[8] init_nonce, byte[32] oracle_pkh) {
    byte[8] repState   = init_rep;
    byte[8] nonceState = init_nonce;

    #[covenant(binding = auth, from = 1, to = 1, mode = transition)]
    function update(
        State   prev_state,
        int     delta,
        pubkey  oracle_pk,
        datasig oracle_sig
    ) : (State) {
        // 1. Oracle identity: presented pubkey must match genesis-committed hash.
        require(blake2b(oracle_pk) == oracle_pkh);

        // 2. Covenant identity: bind verdict to THIS covenant.
        byte[32] covenant_id = OpInputCovenantId(this.activeInputIndex);

        // 3. Verdict: delta(8B) || nonce(8B) || covenant_id(32B) -> blake2b -> 32B digest.
        byte[8] delta_bytes = byte[8](delta);
        byte[] verdict_bytes = delta_bytes + prev_state.nonceState + covenant_id;
        byte[32] msg_hash = blake2b(verdict_bytes);

        // 4. CSFS gate: verify oracle signed this exact verdict.
        require(checkSigFromStack(oracle_sig, msg_hash, oracle_pk));

        // 5. Apply delta.
        int updated = int(prev_state.repState) + delta;
        require(updated >= 0);

        // 6. Advance nonce (anti-replay).
        int next_nonce = int(prev_state.nonceState) + 1;

        return {
            repState:   byte[8](updated),
            nonceState: byte[8](next_nonce)
        };
    }
}
