pragma silverscript ^0.1.0;
contract OracleRep(
    int repState,
) {
    entrypoint function update(int delta) {
        int updated = repState + delta;
        require(updated >= 0);
        byte[] newContract = 0x08 + byte[8](updated) + this.activeScriptPubKey.split(9).1;
        byte[35] newContractLock = new ScriptPubKeyP2SH(blake2b(newContract));
        require(tx.outputs[0].scriptPubKey == byte[](newContractLock));
    }
}
