pragma silverscript ^0.1.0;
contract OracleRep(byte[8] init_rep, byte[32] admin_pkh) {
    byte[8] repState = init_rep;
    #[covenant(binding = auth, from = 1, to = 1, mode = transition)]
     function update(State prev_state, int delta, pubkey admin_pk, sig admin_sig) : (State) {
        require(blake2b(admin_pk) == admin_pkh);
        require(checkSig(admin_sig, admin_pk));
        int updated = int(prev_state.repState) + delta;
        require(updated >= 0);
        return {
            repState: byte[8](updated)
        };
    }
}
